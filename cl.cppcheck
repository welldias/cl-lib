<?xml version="1.0" encoding="UTF-8"?>
<!--
  cppcheck project for cl-lib.

  Run through CMake (see the cppcheck target in CMakeLists.txt):
      cmake --build build --target cppcheck

  or directly from the repository root:
      mkdir -p build/cppcheck
      cppcheck --project=cl.cppcheck --std=c99 \
               --enable=warning,style,performance,portability,information \
               --inline-suppr --error-exitcode=1 -q

  The C standard and the --enable set cannot be stored in the project
  file, so they are passed on the command line.

  Paths are relative to this file. Cached analysis goes to
  build/cppcheck (already ignored by git).
-->
<project version="1">
    <builddir>build/cppcheck</builddir>
    <platform>native</platform>
    <analyze-all-vs-configs>false</analyze-all-vs-configs>
    <check-headers>true</check-headers>
    <check-unused-templates>false</check-unused-templates>
    <max-ctu-depth>4</max-ctu-depth>
    <check-level-exhaustive/>

    <includedir>
        <dir name="include/"/>
        <dir name="src/"/>
    </includedir>

    <!-- Defined by tests/CMakeLists.txt at build time -->
    <defines>
        <define name="CL_FIXTURES_DIR=&quot;cl&quot;"/>
    </defines>

    <paths>
        <dir name="src/"/>
        <dir name="include/"/>
        <dir name="tests/"/>
        <dir name="example/"/>
    </paths>

    <exclude>
        <path name="build/"/>
        <path name="build-asan/"/>
    </exclude>

    <libraries>
        <library>posix</library>
    </libraries>

    <suppressions>
        <!-- Informational: cppcheck reports when it gives up on a branch. -->
        <suppression>checkersReport</suppression>
        <!-- Style-only "could be const" hints; not defects. -->
        <suppression>constVariablePointer</suppression>
        <suppression>constParameterPointer</suppression>
    </suppressions>

    <addons/>
</project>
