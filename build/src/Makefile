	cd /home/welldias/src/cl-lib/cl-lib/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/cl_static.dir/build.make src/CMakeFiles/cl_static.dir/cl_writer.c.o
	cd /home/welldias/src/cl-lib/cl-lib/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/cl_shared.dir/build.make src/CMakeFiles/cl_shared.dir/cl_writer.c.o
.PHONY : cl_writer.c.o

cl_writer.i: cl_writer.c.i
.PHONY : cl_writer.i

# target to preprocess a source file
cl_writer.c.i:
	cd /home/welldias/src/cl-lib/cl-lib/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/cl_static.dir/build.make src/CMakeFiles/cl_static.dir/cl_writer.c.i
	cd /home/welldias/src/cl-lib/cl-lib/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/cl_shared.dir/build.make src/CMakeFiles/cl_shared.dir/cl_writer.c.i
.PHONY : cl_writer.c.i

cl_writer.s: cl_writer.c.s
.PHONY : cl_writer.s

# target to generate assembly for a file
